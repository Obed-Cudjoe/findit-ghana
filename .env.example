# ============================================================
# FindIt Ghana — environment variables
# Copy this file to .env.local for local development, and add
# the same values in Vercel → Project → Settings → Environment
# Variables for production.
# ============================================================

# ---- Optional: Supabase (the free-tier database) -----------
# The site runs in DEMO MODE (local JSON store) until these are
# set. Add them and every form writes to Supabase automatically.
# Steps: supabase.com → New project → Settings → API
# 1. Run supabase/migrations/001_init.sql in the SQL Editor
# 2. Run supabase/seed.sql in the SQL Editor
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin dashboard (P21/P22/P24) --------------------------
# REQUIRED — there is no default. Admin login stays disabled until this is
# set, so pick a long unique password before (or right after) deploying.
ADMIN_PASSWORD=

# ---- Vendor dashboard (/vendor) -----------------------------
# Optional. Signs the 12h shop-login cookie. Falls back to ADMIN_PASSWORD
# when unset. After adding this, run supabase/migrations/004_vendor_passwords.sql.
VENDOR_JWT_SECRET=

# ---- Site identity ------------------------------------------
# Use the production HTTPS URL in Vercel and localhost for local testing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Paystack vendor plan checkout ---------------------------
# Server-only secret key. Never use NEXT_PUBLIC_ for this value and never
# commit your real key. Start with a Paystack TEST secret key; use LIVE only
# after account verification and successful end-to-end testing.
PAYSTACK_SECRET_KEY=

# ---- Jumia affiliate monetization ---------------------------
# Default is Obed's JForce/Jumia affiliate link. Replace this
# with a buyer's own affiliate link during handoff if needed.
NEXT_PUBLIC_JUMIA_AFFILIATE_URL=https://jforce.jumia.com.gh/s/YKEXEt5

# ---- Cron protection ----------------------------------------
# vercel.json calls /api/refresh with this as a Bearer token.
# Generate a long random string, e.g.:  openssl rand -hex 32
CRON_SECRET=

# ---- Optional analytics (free tier) -------------------------
NEXT_PUBLIC_GA_ID=
